[
  [
    ["The cloud sounds"],
    ["harmless, right?"],
    ["Until a giant"],
    ["data centre"],
    ["moves next door."],
    ["Suddenly, it's personal."]
  ],
  [
    ["Behind the AI boom"],
    ["are real buildings,"],
    ["using land, power,"],
    ["and other resources."]
  ],
  [
    ["The International", "Energy Agency"],
    ["expects data-centre", "electricity use"],
    ["to roughly double"],
    ["from twenty", "twenty-five"],
    ["to twenty thirty."]
  ],
  [
    ["So neighbours", "are asking:"],
    ["can our grid cope?"],
    ["And who's paying"],
    ["for those new", "power lines?"]
  ],
  [
    ["Some cooling systems"],
    ["use water,"],
    ["depending on their", "design and location."],
    ["In dry regions,"],
    ["that matters."]
  ],
  [
    ["Others worry", "about noise"],
    ["from cooling", "equipment"],
    ["and backup", "generators"],
    ["near their homes."]
  ],
  [
    ["From Mexico"],
    ["to South Africa,"],
    ["communities", "have demanded"],
    ["clearer answers"],
    ["about projects"],
    ["on their doorstep."]
  ],
  [
    ["Of course,", "data centres"],
    ["run useful services."],
    ["Supporters point to"],
    ["investment and", "tax revenue."],
    ["Those benefits", "matter, too."]
  ],
  [
    ["But so does", "the deal:"],
    ["transparent", "resource use,"],
